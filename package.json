{
  "name": "local-reading-assistant",
  "version": "0.14.2",
  "description": "A local-first Chrome reading assistant with bring-your-own API and ChatGPT sign-in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aurum9/yuechuang.git"
  },
  "bugs": {
    "url": "https://github.com/Aurum9/yuechuang/issues"
  },
  "homepage": "https://github.com/Aurum9/yuechuang#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:context": "node tests/context-e2e.mjs",
    "test:phrases": "node tests/phrases-e2e.mjs",
    "test:research": "node tests/research-e2e.mjs",
    "test:sidebar": "node tests/sidebar-e2e.mjs",
    "test:webchat": "node tests/webchat-e2e.mjs",
    "test:webchat-page": "node tests/webchat-page-e2e.mjs",
    "test:webchat-webapp": "node tests/webchat-webapp-e2e.mjs",
    "test:siwc-ui": "node tests/siwc-ui-e2e.mjs",
    "fixtures": "node tests/fixtures/server.mjs",
    "package": "node scripts/package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:siwc-auth": "node tests/siwc-auth-e2e.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "3.4.17",
    "marked": "18.1.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "fflate": "^0.8.2",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
